[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://textures/menu_backdrop.png" id="2_backdrop"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Backdrop" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_backdrop")
expand_mode = 1
stretch_mode = 6

[node name="Tint" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.06, 0.12, 0.6)

[node name="CenterBox" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(460, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -180.0
offset_right = 230.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="CenterBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Badge" type="Label" parent="CenterBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.97, 1)
theme_override_font_sizes/font_size = 11
text = "3D ACTION MOUNTAIN SHOOTER"
horizontal_alignment = 1

[node name="Title" type="Label" parent="CenterBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 46
text = "KOizi"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.75, 0.2, 1)
theme_override_font_sizes/font_size = 14
text = "— SEVEN SUMMITS (3D) —"
horizontal_alignment = 1

[node name="Desc" type="Label" parent="CenterBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 12
text = "Scale seven 3D mountain peaks, blast ridge guardians to ignite each 3D Summit Portal, and defeat the Summit Overlord on Peak 7!"
horizontal_alignment = 1
autowrap_mode = 2

[node name="HBoxButtons" type="HBoxContainer" parent="CenterBox/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PlayBtn" type="Button" parent="CenterBox/VBox/HBoxButtons"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "▶ PLAY KOizi"

[node name="LevelsBtn" type="Button" parent="CenterBox/VBox/HBoxButtons"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "⛰ SEVEN SUMMITS"

[node name="ControlsPanel" type="PanelContainer" parent="CenterBox/VBox"]
layout_mode = 2

[node name="Grid" type="GridContainer" parent="CenterBox/VBox/ControlsPanel"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
