[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_cred"]
script/source = "extends Control

signal closed

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS

func _on_close_pressed() -> void:
	hide()
	closed.emit()
"

[node name="CreditsModal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_cred")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.04, 0.08, 0.75)

[node name="CenterBox" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(460, 360)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -180.0
offset_right = 230.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="CenterBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="CenterBox/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.96, 0.75, 0.2, 1)
theme_override_font_sizes/font_size = 20
text = "★ CREDITS & ATTRIBUTIONS ★"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="CenterBox/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="VBoxContent" type="VBoxContainer" parent="CenterBox/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="GameTitle" type="Label" parent="CenterBox/VBox/Scroll/VBoxContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.8, 0.95, 1)
theme_override_font_sizes/font_size = 14
text = "KOizi — SEVEN SUMMITS (3D)"
horizontal_alignment = 1

[node name="Engine" type="Label" parent="CenterBox/VBox/Scroll/VBoxContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Engine: Godot 4.7+ (Forward+ 3D / Static Mesh Pipeline)
License: MIT License (godotengine.org)"
autowrap_mode = 2

[node name="AudioCredits" type="Label" parent="CenterBox/VBox/Scroll/VBoxContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Audio & SFX:
Synthesized retro 8-bit & 16-bit mountain audio (CC0 / Public Domain)
Kenney Audio Assets & Custom GDScript Synth wav tables."
autowrap_mode = 2

[node name="VisualCredits" type="Label" parent="CenterBox/VBox/Scroll/VBoxContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Art & Textures:
Pixel art textures (CC0 Public Domain)
Low-poly mountain environment geometry and voxel-style climber rig."
autowrap_mode = 2

[node name="Hackathon" type="Label" parent="CenterBox/VBox/Scroll/VBoxContent"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Developed for Game Jam / Hackathon.
All 7 summits, boss encounters, and settings configured for optimal 60+ FPS performance."
autowrap_mode = 2

[node name="CloseBtn" type="Button" parent="CenterBox/VBox"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "CLOSE"

[connection signal="pressed" from="CenterBox/VBox/CloseBtn" to="." method="_on_close_pressed"]
